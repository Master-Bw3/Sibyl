{
	"schemaVersion": 1,
	"id": "sibyl",
	"version": "${version}",
	"name": "Sibyl",
	"description": "Sibyl is an addon for Trickster that adds autocomplete to the Spell GUI.",
	"authors": [
		"Master_Bw3"
	],
	"contact": {
		"homepage": "https://master-bw3.carrd.co",
		"sources": "https://github.com/Master-Bw3/Sibyl",
		"issues": "https://github.com/Master-Bw3/Sibyl/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/sibyl/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "mod.master_bw3.sibyl.Sibyl",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "mod.master_bw3.sibyl.SibylClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"sibyl.mixins.json",
		{
			"config": "sibyl.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": ">=1.21",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"fabric-key-binding-api-v1": "*",
		"trickster": ">=2.0.0-beta.44"
	},
	"suggests": {
	},
	"custom": {
	}
}